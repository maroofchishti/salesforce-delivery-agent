{
  "mcpServers": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    },
    "salesforce": {
      "command": "npx",
      "args": [
        "-y",
        "@salesforce/mcp",
        "--orgs",
        "${SF_AGENT_ORG:-DEFAULT_TARGET_ORG}",
        "--toolsets",
        "orgs,data,metadata",
        "--no-telemetry"
      ]
    }
  }
}
